# Confam configuration. `npm run setup` creates .env from this file and fills generated values.

# --- Server ---
PORT=8787
PUBLIC_BASE_URL=http://localhost:8787
CORS_ORIGINS=http://localhost:5173
DB_PATH=./data/confam.db

# --- Lightning (merchant wallet that issues HOLD invoices) ---
# nwc: any NIP-47 wallet that supports make_hold_invoice / settle_hold_invoice / cancel_hold_invoice
#      (e.g. Alby Hub, or a faucet.nwc.dev test wallet for demos). Grant it NO pay_invoice permission.
# lnd: LND REST + an *invoice* macaroon (cannot send funds).
LN_BACKEND=nwc
MERCHANT_NWC_URL=
LND_REST_URL=
LND_INVOICE_MACAROON_HEX=
LIGHTNING_NETWORK_LABEL=NWC test wallets

# --- VTpass bill payments (https://sandbox.vtpass.com > Account > API Keys) ---
VTPASS_BASE_URL=https://sandbox.vtpass.com
VTPASS_API_KEY=
VTPASS_PUBLIC_KEY=
VTPASS_SECRET_KEY=

# --- Africa's Talking: airtime in 15 African countries (https://account.africastalking.com/apps/sandbox) ---
# Sandbox: AT_USERNAME=sandbox and the sandbox app's API key (Settings > API Key). Free, no KYC.
AT_USERNAME=
AT_API_KEY=
# Secret path segment for the airtime status callback (generated by setup). Callback URL to set in the
# AT dashboard (Airtime > Callback URLs > Status): <PUBLIC_BASE_URL>/api/webhooks/africastalking/airtime/<token>
AT_CALLBACK_TOKEN=

# --- Reloadly (optional; not available to accounts registered in Nigeria): airtime & data across Africa (reloadly.com > Developers > API Settings, Test mode) ---
RELOADLY_BASE_URL=https://topups-sandbox.reloadly.com
RELOADLY_CLIENT_ID=
RELOADLY_CLIENT_SECRET=

# --- Signed delivery receipts (generated by setup; keep secret) ---
NOSTR_SECRET_KEY_HEX=

# --- Money rules ---
INVOICE_EXPIRY_SEC=600
VEND_DEADLINE_SEC=90
MIN_ORDER_NGN=50
MAX_ORDER_NGN=50000
MAX_ORDER_SATS=100000
SERVICE_FEE_BPS=0

# --- Demo helpers ---
TEST_WALLET_FAUCET=true
TEST_WALLET_BALANCE_SATS=25000
